<?xml version="1.0" encoding="UTF-8"?>
<!--
  repo local manifest for the IVI controller (copy to .repo/local_manifests/).
  Adds COVESA vsomeip and the Central Control Gateway sources to the AOSP tree;
  then run vendor/ccg/central-control-gateway/android/setup_aosp.sh.
-->
<manifest>
  <remote name="ccg-github" fetch="https://github.com/" />

  <!--
    Some AOSP / SDV trees already contain Google's copy of vsomeip, which defines
    the same module names (libvsomeip3, ...). Remove it, e.g.:
    <remove-project name="platform/external/sdv/vsomeip" />
  -->

  <project name="COVESA/vsomeip"
           path="external/vsomeip"
           remote="ccg-github"
           revision="refs/tags/3.7.6"
           clone-depth="1" />

  <project name="johnnyxia7-code/Central-control-gateway"
           path="vendor/ccg/central-control-gateway"
           remote="ccg-github"
           revision="main" />
</manifest>
